# ─── Variables de entorno — EJEMPLO ───────────────────────────────────────────
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA subas .env.local al repositorio.

# ─── General ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── URL pública del sitio ─────────────────────────────────────────────────────
# En Vercel se puede usar VERCEL_URL automáticamente
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Nombre del sitio ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=Making Real

# ─── Base de datos (cuando se integre Prisma + PostgreSQL) ────────────────────
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# ─── Autenticación (cuando se integre) ───────────────────────────────────────
# NEXTAUTH_SECRET=tu-secreto-seguro-aquí
# NEXTAUTH_URL=http://localhost:3000

# ─── Servicios externos (cuando se integren) ─────────────────────────────────
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
